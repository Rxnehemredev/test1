# /etc/cron.d/asteria   (vercel.json'daki zamanlamalarla aynı)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 8 * * * asteria /opt/asteria/deploy/cron/run-cron.sh blog-queue   >> /var/log/asteria-cron.log 2>&1
0 9 * * * asteria /opt/asteria/deploy/cron/run-cron.sh scraper-sync  >> /var/log/asteria-cron.log 2>&1
