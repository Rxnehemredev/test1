# Bu dosyayı /etc/nginx/asteria-proxy-secret.conf olarak kopyala ve sırrı doldur:
#   sudo install -m 600 -o root -g root asteria-proxy-secret.conf.example /etc/nginx/asteria-proxy-secret.conf
# Değer, uygulamanın .env dosyasındaki PROXY_SHARED_SECRET ile BİREBİR aynı olmalı.
# Üretmek için:  openssl rand -hex 32
proxy_set_header X-Asteria-Proxy "BURAYA_PROXY_SHARED_SECRET_DEGERI";
