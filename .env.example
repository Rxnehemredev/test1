# Asteria Scans — ortam değişkenleri
#
# Yerelde:  cp .env.example .env.local   (ve .env.local'ı ASLA git'e eklemeyin)
# Vercel'de: Project Settings > Environment Variables. Değişken ekledikten/
#            değiştirdikten sonra "Redeploy" yapın, yoksa canlı site etkilenmez.
# Değerleri tırnak içine ALMAYIN, başına/sonuna boşluk koymayın.
# Örnek/placeholder metinleri (BURAYA_..., SENIN_...) gerçek değer sayılmaz — boş bırakmak da aynı sonucu verir.
#
# Bölümler:  1) ANA DEĞİŞKENLER (her kurulumda doldurulur)   2) EK DEPOLAMA SEÇENEKLERİ
#            3) AI BLOG AYARLARI   4) ÖNERİLEN / OPSİYONEL   5) GEÇİCİ   6) VERCEL DIŞI (VPS/Docker)


# ══════════════════════════════════════════════════════════════════════════
# 1) ANA DEĞİŞKENLER — hepsini doldurun
# ══════════════════════════════════════════════════════════════════════════

# ── Veritabanı: Turso (https://turso.tech) ── ZORUNLU
# TURSO_DATABASE_URL örn: libsql://veritabani-adin.turso.io   (Supabase/Postgres adresi DEĞİL)
# TURSO_AUTH_TOKEN: Turso panelinden "Create Token" ile alınır
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Oturum / güvenlik anahtarları ── ZORUNLU (üçü de FARKLI değer olmalı)
# JWT_SECRET: oturum (JWT) imzası. Üret: openssl rand -hex 32
JWT_SECRET=
# ENCRYPTION_KEY: saklı üçüncü parti API anahtarlarını (Torii) şifreler. 32 byte = 64 hex karakter.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Mevcut kurulumlar için migration notu: CHANGELOG.md → "ENCRYPTION_KEY migration notu".
ENCRYPTION_KEY=
# IMAGE_PROXY_SECRET: /api/img imzalı görsel linkleri için HMAC anahtarı (en az 32 karakter). Üret: openssl rand -hex 32
IMAGE_PROXY_SECRET=

# ── Yönetici hesapları ── ZORUNLU
# ADMIN_EMAIL + ADMIN_EMAIL_2: 2 admin e-postası.
# ADMIN_EMAILS: EK adminler (virgülle ayrılmış, örn: a@x.com,b@y.com). Gerek yoksa boş bırakın.
# ADMIN_PASSWORD: bu hesapların ortak şifresi (en az 10 karakter). Hesaplar ilk açılışta otomatik oluşturulur.
ADMIN_EMAIL=
ADMIN_EMAIL_2=
ADMIN_EMAILS=
ADMIN_PASSWORD=

# Sitenin adresi, sonunda "/" olmadan. Örn: https://asteriascans.com
# (NEXT_PUBLIC_ ile başlayan değişkenler BUILD sırasında koda gömülür → değiştirince yeniden deploy şart.)
NEXT_PUBLIC_BASE_URL=

# ── Rate limit + saldırı koruması: Upstash Redis (https://upstash.com) ── PRODUCTION'DA (Vercel) ZORUNLU
# Upstash > veritabanı > "REST API" bölümündeki URL ve Token.
# Boşsa limitler sunucu başına bellek-içinde tutulur (serverless'ta işe yaramaz);
# bu durumda login/register/admin uçlarına otomatik daha sıkı limit uygulanır ve log'a uyarı yazılır.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Görsel yükleme: imgbb (varsayılan depolama) ── https://api.imgbb.com/
IMGBB_API_KEY=

# ── Görsel depolama: Supabase Storage ── admin panelde depolama olarak "Supabase" seçilecekse ZORUNLU
# SUPABASE_URL: Supabase Dashboard > Settings > API > Project URL (örn. https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: aynı sayfadaki "service_role" anahtarı (ANON key DEĞİL, gizli tutun; asla NEXT_PUBLIC_ yapmayın)
# SUPABASE_BUCKET: Storage'da oluşturduğunuz bucket adı; "Public" olmalı (boşsa "uploads")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# ── AI blog: Gemini (https://aistudio.google.com/apikey) ── blog üretimi için ZORUNLU
# Başında/sonunda boşluk veya tırnak olmasın. Alternatif: anahtarı Admin Panel > Blog Yönetimi
# sayfasındaki "Gemini API Anahtarı" kutusundan da girebilirsiniz (redeploy gerekmez).
# (Kod ayrıca GOOGLE_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, GEMINI_KEY gibi yaygın isimleri de tanır.)
GEMINI_API_KEY=


# ══════════════════════════════════════════════════════════════════════════
# 2) EK DEPOLAMA SEÇENEKLERİ (opsiyonel — imgbb/Supabase yeterliyse boş bırakın)
# ══════════════════════════════════════════════════════════════════════════

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Cloudflare R2 — seçilecekse 5'i de ZORUNLU
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.ornek.com


# ══════════════════════════════════════════════════════════════════════════
# 3) AI BLOG AYARLARI (opsiyonel)
# ══════════════════════════════════════════════════════════════════════════

# Blog için farklı/daha hızlı Gemini modeli (varsayılan: gemini-3.6-flash)
# AI_BLOG_MODEL=gemini-3.5-flash-lite

# Zamanlanmış işler (blog kuyruğu, scraper) için gizli anahtar. Boşsa cron uçları çalışmaz.
# İsterseniz iş başına ayrı verebilirsiniz: BLOG_CRON_SECRET / SCRAPER_CRON_SECRET (yoksa CRON_SECRET kullanılır).
# Üret: openssl rand -hex 32
# CRON_SECRET=
# BLOG_CRON_SECRET=
# SCRAPER_CRON_SECRET=


# ══════════════════════════════════════════════════════════════════════════
# 4) ÖNERİLEN / OPSİYONEL (gerekirse başındaki # işaretini kaldırın)
# ══════════════════════════════════════════════════════════════════════════

# ADMIN_EMAIL (tek admin kurulumunda) için isteğe bağlı kullanıcı adı ipucu:
# ADMIN_USERNAME=

# Yorumlardaki GIF araması (boşsa GIPHY'nin genel test anahtarı kullanılır — düşük limit)
# GIPHY_API_KEY=

# Torii API anahtarı. Normalde admin panelden girilir (şifreli saklanır); panelde yoksa buradan okunur.
# TORII_API_KEY=

# Admin panelini yalnızca belirli IP'lere açmak için (virgülle ayrılmış)
# ADMIN_ALLOWED_IPS=

# İstemci IP'sinin nasıl belirleneceği (rate limit + ADMIN_ALLOWED_IPS bunu kullanır). Öncelik sırası:
#  1) TRUSTED_PROXY=cloudflare  → cf-connecting-ip (tüm trafik Cloudflare'den geçiyorsa)
#  2) TRUSTED_PROXY_COUNT=N     → KENDİ proxy zincirinizde (nginx, ALB, ...) uygulamanın önündeki
#     güvenilir proxy sayısı; x-forwarded-for'da SAĞDAN N. eleman alınır (soldakiler istemci
#     tarafından uydurulabilir, asla kullanılmaz). Zincir N'den kısaysa IP '0.0.0.0' olur (fail-closed).
#  3) Vercel'de (otomatik)      → x-real-ip / x-forwarded-for'un ilk elemanı (Vercel bunları ezer)
# Vercel'de ikisini de boş bırakın.
# TRUSTED_PROXY=
# TRUSTED_PROXY_COUNT=

# Cloudflare Turnstile (bot koruması): site/secret anahtarları ortam değişkeni DEĞİL, Admin Panel > Ayarlar'dan girilir.
# Yalnızca YEREL GELİŞTİRMEDE kapatmak için (production'da DISABLE_TURNSTILE yok sayılır):
# DISABLE_TURNSTILE=1
# NEXT_PUBLIC_DISABLE_TURNSTILE=1

# Google/Bing'e otomatik URL bildirimi (IndexNow)
# INDEXNOW_KEY=

# Ziyaretçi istatistiği (Firebase Analytics)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Yerel SQLite dosya yolu — yalnızca admin panelindeki depolama istatistiği okur (veritabanı Turso'dur). Varsayılan: ./data/manga.db
# DATABASE_PATH=

# Yalnızca ilk kurulumda, boş sitede örnek (demo) seri/kullanıcı eklemek için:
# SEED_DEMO_DATA=1


# ══════════════════════════════════════════════════════════════════════════
# 5) GEÇİCİ / NADİREN GEREKEN — işiniz bitince SİLİN, üretimde açık bırakmayın
# ══════════════════════════════════════════════════════════════════════════

# ADMIN_RESET_PASSWORD=1   → admin şifrelerini ADMIN_PASSWORD'e sıfırlar
# (DEBUG_ERRORS kaldırıldı: gerçek hata metni artık istemciye ASLA dönmez; sunucu log'una bakın.)


# ══════════════════════════════════════════════════════════════════════════
# 6) VERCEL DIŞI (VPS / Docker / kendi sunucu) KURULUMU — bkz. SELFHOST-SECURITY.md
# Vercel'de bu bölümdeki HİÇBİR değişkeni tanımlamayın (SELF_HOSTED özellikle boş kalmalı).
# ══════════════════════════════════════════════════════════════════════════

# Vercel dışı kilit modu. 1 = uygulamaya YALNIZCA nginx üzerinden girilebilir (aşağıdaki sır olmadan 403),
# yapılandırma eksikse site açık kalmak yerine 503 verir (fail-closed).
# SELF_HOSTED=1

# nginx ile uygulama arasındaki gizli anahtar (en az 32 karakter). Üret: openssl rand -hex 32
# nginx tarafında /etc/nginx/asteria-proxy-secret.conf içindeki değerle BİREBİR aynı olmalı.
# JWT_SECRET / ENCRYPTION_KEY / IMAGE_PROXY_SECRET ile aynı OLMAMALI (scripts/selfhost-check.mjs kontrol eder).
# PROXY_SHARED_SECRET=

# nginx tek proxy ise TRUSTED_PROXY_COUNT=1 (yukarıda 4. bölümde açıklandı; Cloudflare + nginx'te
# nginx'te cloudflare-realip.conf kullan, yine 1 kalır).

# İzin verilen alan adları (virgüllü; *.ornek.com desteklenir). NEXT_PUBLIC_BASE_URL ve www. varyantı otomatik eklenir.
# Host-header saldırıları, cache poisoning ve CSRF (Origin) kontrolü bunu kullanır.
# ALLOWED_HOSTS=ornek.com,www.ornek.com

# Uygulamanın kendi kendine yaptığı iç istekler (DDoS gate ayarı) için; internete çıkıp nginx'e dönmez.
# INTERNAL_ORIGIN=http://127.0.0.1:3000

# İstek gövdesi tavanları (MB). nginx'teki client_max_body_size ile uyumlu tutun.
# BODY_LIMIT_API_MB=1
# BODY_LIMIT_UPLOAD_MB=8
# BODY_LIMIT_ADMIN_MB=64

# Threat Shield ayarları (Redis olmadan bellek deposu kullanılır — tek sunucuda tam doğrudur)
# THREAT_SHIELD_RPS_THRESHOLD=80        # site geneli saniyede bu kadar istek → saldırı modu
# THREAT_SHIELD_VIOLATION_THRESHOLD=3   # ağırlıklı ihlal puanı eşiği → ban
# SHIELD_MEM_MAX_ENTRIES=100000         # bellek deposu üst sınırı

# Docker imajını bağımsız (standalone) çıktıyla derlemek için (deploy/docker/Dockerfile bunu kendisi ayarlar):
# BUILD_STANDALONE=1

# Cron işleri (Vercel Cron yok): deploy/cron/asteria.crontab — gizli anahtarlar 3. bölümdeki CRON_SECRET / BLOG_CRON_SECRET / SCRAPER_CRON_SECRET.
